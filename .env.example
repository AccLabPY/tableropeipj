# ============================================================
# Plataforma PEI 2026-2030 · Variables de entorno
# Copiar a .env y completar. NUNCA commitear credenciales.
# ============================================================

# Base de datos PRODUCCIÓN (TiDB Serverless, MySQL 8 compatible, TLS obligatorio)
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST:4000/peipj?sslaccept=strict&connection_limit=5&pool_timeout=15"

# Base de datos TEST/DEMO (mismo clúster, database peipj_test con datos mockup)
DATABASE_URL_TEST="mysql://USUARIO:PASSWORD@HOST:4000/peipj_test?sslaccept=strict&connection_limit=5&pool_timeout=15"

# Secreto de Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Entorno de datos que ven los usuarios NO administradores:
#   "prod" en producción (Render) · "test" en desarrollo local
DB_DEFAULT_ENV=prod
