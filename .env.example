# ============================================================
# Plataforma PEI 2026-2030 · Variables de entorno
# Copiar a .env y completar. NUNCA commitear credenciales.
# En pnud-app el archivo real vive en /opt/peipj/.env (fuera del repo).
# ============================================================

# Base de datos PRODUCCIÓN (PostgreSQL 17 en pnud-db, LAN del PJ)
DATABASE_URL="postgresql://peipj_app:PASSWORD@172.30.150.21:5432/peipj?schema=public&connection_limit=5&pool_timeout=15&connect_timeout=10&sslmode=disable"

# Base de datos TEST/DEMO (mismo clúster, database peipj_test con datos mockup)
DATABASE_URL_TEST="postgresql://peipj_app:PASSWORD@172.30.150.21:5432/peipj_test?schema=public&connection_limit=5&pool_timeout=15&connect_timeout=10&sslmode=disable"

# Secreto de Auth.js — generar con: openssl rand -base64 32
AUTH_SECRET=""
# URL canónica pública (TLS termina en el proxy institucional; Next recibe HTTP)
AUTH_URL="https://pei.csj.gov.py"
AUTH_TRUST_HOST=true

# Entorno de datos que ven los usuarios NO administradores:
#   "prod" en producción · "test" en desarrollo local
DB_DEFAULT_ENV=prod
